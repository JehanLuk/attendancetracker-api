@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>@ViewData["Title"]</h1>
<link rel="stylesheet" href="~/css/dashboard.css" />
<p class="description">Aqui vai o conteúdo do dashboard (valores, gráficos, anotações e justificativas).</p>

<main>
    <h2>Disciplina Atual</h2>
    <div class="cards">
        <div class="card1">TOTAL DE ALUNOS <div id="number">@ViewData["TotalAlunos"]</div></div>
        <div class="card2">PRESENTES <div id="number">@ViewData["ValorPresentes"]</div></div>
        <div class="card3">DISPENSADOS <div id="number">@ViewData["ValorDispensados"]</div></div>
        <div class="card4">FALTANTES <div id="number">@ViewData["ValorFaltas"]</div></div>
        <div class="card5">ALUNOS EXTRAS <div id="number">@ViewData["ValorAlunoExtra"]</div></div>
    </div>

    <!-- Gráfico usando Chart.js -->
    <div class="nomesOrganizacao">
        <h2>Geral</h2>
        <h2 class="disciplinaFiltro">Filtrar por Disciplina</h2>
    </div>

    <div class="grafico-tabela">
        <div class="grafico">
            <canvas id="myChart"></canvas>
        </div>
        <div class="justanoTabela">
            <h3>Anotações e Justificativas</h3>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Dados iniciais das disciplinas
let disciplinasData = {
    'ADS': {
        presencas: parseInt('@ViewData["TotalAlunos"]') || 0,
        dispensos: 5,
        faltas: parseInt('@ViewData["ValorFaltas"]') || 0,
        alunosExtras: 2
    },
    'Disciplina2': {
        presencas: 15,
        dispensos: 10,
        faltas: 10,
        alunosExtras: 3
    },
    'Disciplina3': {
        presencas: 20,
        dispensos: 7,
        faltas: 7,
        alunosExtras: 1
    }
};

let myChart;

// Função para inicializar o gráfico
function inicializarGrafico() {
    const ctx = document.getElementById('myChart');
    
    const disciplinas = Object.keys(disciplinasData);
    const presencas = disciplinas.map(d => disciplinasData[d].presencas);
    const dispensos = disciplinas.map(d => disciplinasData[d].dispensos);
    const faltas = disciplinas.map(d => disciplinasData[d].faltas);
    const alunosExtras = disciplinas.map(d => disciplinasData[d].alunosExtras);

    myChart = new Chart(ctx, {
        type: 'bar',
        data: {
            labels: disciplinas,
            datasets: [
                { 
                    label: 'Presenças', 
                    data: presencas, 
                    backgroundColor: '#50C35D' 
                },
                { 
                    label: 'Dispensos', 
                    data: dispensos, 
                    backgroundColor: '#ffd04d' 
                },
                { 
                    label: 'Faltas', 
                    data: faltas, 
                    backgroundColor: '#bd4646ff' 
                },
                { 
                    label: 'Alunos Extras', 
                    data: alunosExtras, 
                    backgroundColor: '#8750C3' 
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: { 
                    beginAtZero: true,
                    title: {
                        display: true,
                        text: 'Quantidade de Alunos'
                    }
                },
                x: {
                    title: {
                        display: true,
                        text: 'Disciplinas'
                    }
                }
            },
            plugins: {
                legend: {
                    position: 'top',
                },
                title: {
                    display: true,
                    text: 'Distribuição de Alunos por Disciplina'
                }
            }
        }
    });
}

// Função para adicionar novo aluno
function adicionarAluno(disciplina, tipo) {
    if (disciplinasData[disciplina]) {
        disciplinasData[disciplina][tipo]++;
        atualizarGrafico();
    } else {
        console.error('Disciplina não encontrada:', disciplina);
    }
}

// Função para adicionar nova disciplina
function adicionarDisciplina(nomeDisciplina, dadosIniciais = {}) {
    disciplinasData[nomeDisciplina] = {
        presencas: dadosIniciais.presencas || 0,
        dispensos: dadosIniciais.dispensos || 0,
        faltas: dadosIniciais.faltas || 0,
        alunosExtras: dadosIniciais.alunosExtras || 0
    };
    atualizarGrafico();
}

// Função para atualizar o gráfico
function atualizarGrafico() {
    const disciplinas = Object.keys(disciplinasData);
    const presencas = disciplinas.map(d => disciplinasData[d].presencas);
    const dispensos = disciplinas.map(d => disciplinasData[d].dispensos);
    const faltas = disciplinas.map(d => disciplinasData[d].faltas);
    const alunosExtras = disciplinas.map(d => disciplinasData[d].alunosExtras);

    myChart.data.labels = disciplinas;
    myChart.data.datasets[0].data = presencas;
    myChart.data.datasets[1].data = dispensos;
    myChart.data.datasets[2].data = faltas;
    myChart.data.datasets[3].data = alunosExtras;
    
    myChart.update();
}

// Função para obter estatísticas
function obterEstatisticas() {
    const totalPorDisciplina = {};
    
    Object.keys(disciplinasData).forEach(disciplina => {
        const dados = disciplinasData[disciplina];
        totalPorDisciplina[disciplina] = {
            total: dados.presencas + dados.dispensos + dados.faltas + dados.alunosExtras,
            ...dados
        };
    });
    
    return totalPorDisciplina;
}

// Inicializar o gráfico quando a página carregar
document.addEventListener('DOMContentLoaded', function() {
    inicializarGrafico();
});
</script>
